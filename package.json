{
  "name": "ssff-mcp",
  "version": "0.1.2",
  "description": "Local read-only MCP server for SAP SuccessFactors OData v2 (STDIO transport)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiptime/ssff-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/chiptime/ssff-mcp/issues"
  },
  "homepage": "https://github.com/chiptime/ssff-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sap",
    "successfactors",
    "odata",
    "odata-v2",
    "read-only"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ssff-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "config.template.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "pnpm build && node --test dist/test/",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "fast-xml-parser": "^5.0.0",
    "odata-batch": "2.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
