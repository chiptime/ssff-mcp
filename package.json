{
  "name": "ssff-mcp",
  "version": "0.7.0-rc.1",
  "description": "Read-only MCP server for SAP SuccessFactors OData v2 (STDIO and authenticated Streamable HTTP)",
  "license": "MIT",
  "publishConfig": {
    "tag": "next"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiptime/ssff-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/chiptime/ssff-mcp/issues"
  },
  "homepage": "https://github.com/chiptime/ssff-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sap",
    "successfactors",
    "odata",
    "odata-v2",
    "read-only"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ssff-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "assets",
    "config.template.json",
    "config.hosted.template.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc",
    "prepack": "npm run build",
    "test": "pnpm build && node --test dist/test/",
    "typecheck": "tsc --noEmit",
    "docs:gen": "pnpm build && node scripts/generate-tools-doc.mjs",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "fast-xml-parser": "^5.0.0",
    "odata-batch": "2.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
